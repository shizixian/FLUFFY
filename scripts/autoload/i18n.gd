var lang := "zh_CN"


func set_lang(code: String) -> void:
	if not S.has(code) or code == lang:
		return
	lang = code
	changed.emit()


func t(key: String, args: Array = []) -> String:
	var table: Dictionary = S.get(lang, S["zh_CN"])
	var s: String = table.get(key, S["zh_CN"].get(key, key))
	if args.is_empty():
		return s
	return s % args
